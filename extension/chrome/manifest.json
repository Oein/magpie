{
  "manifest_version": 3,
  "name": "Magpie",
  "version": "0.1.0",
  "description": "Forward browser downloads (with cookies and request headers) to the Magpie download manager.",
  "icons": {
    "16": "icons/magpie-16.png",
    "32": "icons/magpie-32.png",
    "48": "icons/magpie-48.png",
    "128": "icons/magpie-128.png"
  },
  "permissions": [
    "downloads",
    "cookies",
    "webRequest",
    "storage",
    "nativeMessaging",
    "notifications",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Magpie",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/magpie-16.png",
      "32": "icons/magpie-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
